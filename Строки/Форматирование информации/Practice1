import java.util.Formatter;

public class Main {

    public static void main(String[] args) {

        Formatter format = new Formatter();
        format.format("Integer: %d%n", 42);
        format.format("Float: %.2f%n", 3.14159);
        format.format("Boolean: %b%n", true);
        format.format("String: %s%n", "hello");
        format.format("Знак процента: %% %n");
        System.out.print(format.toString());
        format.close();
    }
}
